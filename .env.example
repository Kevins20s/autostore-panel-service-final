# Salin file ini jadi .env lalu isi nilainya (tanpa spasi, tanpa tanda kutip).

# Wajib. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# Wajib. Password halaman admin, minimal 8 karakter, pakai yang panjang.
ADMIN_PASSWORD=

# Di server asli (VPS + HTTPS), isi ini:
# PUBLIC_URL=https://panel.domainmu.my.id
# COOKIE_SECURE=1
# TRUST_PROXY=1

# Opsional
# PANEL_PORT=8080
# BASE_PORT=4000

# --- Khusus Railway (isi di menu Variables Railway, bukan di file) ---
# PANEL_HOST=0.0.0.0
# DATA_FILE=/data/data.json
# PUBLIC_URL=https://nama-app.up.railway.app
# COOKIE_SECURE=1
# TRUST_PROXY=1
# Backup otomatis data.json ke Discord (URL webhook dari channel privat milikmu)
# BACKUP_WEBHOOK_URL=https://discord.com/api/webhooks/...
# BACKUP_EVERY_HOURS=12   (opsional, default 12)

# --- Pembayaran key di halaman /beli ---
# Pembeli bisa bayar lewat QRIS dinamis yang terdeteksi otomatis (key langsung jadi).
# Syarat: AUTOKO_MODE=live + AUTOKO_API_KEY + PUBLIC_URL (https). Kalau gateway gagal, otomatis jatuh ke QRIS statis + konfirmasi admin.
# ORDER_AUTO=1
# ORDER_TTL_MIN=30
# ORDER_SWEEP_MS=60000    (cek status ke gateway untuk webhook yang terlewat)
# Harga paket diubah dari halaman admin, bukan di sini.

# --- Login Discord (redirect: PUBLIC_URL/api/auth/discord/callback) ---
# DISCORD_LOGIN_CLIENT_ID=
# DISCORD_LOGIN_CLIENT_SECRET=
# Isi hanya setelah bot GevraStore siap melayani beberapa server dengan data terpisah.
# DISCORD_HOSTED_BOT_CLIENT_ID=
# DISCORD_HOSTED_BOT_PERMISSIONS=0
# Batasi pemilih server saat pilot. Isi ID lisensi dan daftar ID server dipisah koma.
# DISCORD_HOSTED_PILOT_LICENSE_ID=
# DISCORD_HOSTED_PILOT_GUILD_IDS=
# DISCORD_HOSTED_PILOT_STATUS_FILE=

# --- Bot GevraStore pilot untuk guild tes ---
# DISCORD_CATALOG_PILOT_TOKEN=
# MongoDB dengan dukungan transaksi. Pisahkan dari database produksi saat pengujian.
# DISCORD_CATALOG_PILOT_MONGO_URL=
# QRIS sungguhan membutuhkan Wallet dan Autoko live. Aktifkan hanya saat tes pembayaran.
# DISCORD_CATALOG_PILOT_QRIS=0

# --- CAPTCHA gratis di form /beli (Cloudflare Turnstile) ---
# Buat widget di dash.cloudflare.com > Turnstile, isi dua nilai ini. Kosong = CAPTCHA mati.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# --- Notifikasi ke HP (pesanan baru, bot crash, selisih saldo wallet) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NTFY_TOPIC=

# --- Wallet (saldo toko pembeli, QRIS otomatis) ---
# Database wallet sebaiknya MongoDB Atlas milikmu sendiri dan DIBACKUP (Atlas gratis M0 tidak punya backup otomatis).
# Selain itu, panel mengirim backup wallet ke Discord (BACKUP_WEBHOOK_URL) bersama backup data.json.
# WALLET_MONGO_URL=
# WALLET_DB_NAME=autostore_wallet
# WALLET_HOLD_HOURS=3          (uang masuk ditahan dulu sebelum bisa ditarik)
# WALLET_FEE_PERCENT=0         (biaya persen per deposit. 0 = kamu tidak dapat apa-apa dari tiap transaksi)
# WALLET_FEE_FLAT=0            (biaya tetap per deposit, Rp)
# WALLET_MIN_DEPOSIT=1000
# WALLET_MAX_DEPOSIT=5000000
# WALLET_MIN_WITHDRAW=10000
# WALLET_WITHDRAW_FEE=0
# WALLET_CHECK_HOURS=24        (cek harian saldo vs ledger, kabari lewat notifikasi kalau beda)

