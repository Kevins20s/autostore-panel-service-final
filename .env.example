# Salin file ini jadi .env lalu isi nilainya (tanpa spasi, tanpa tanda kutip).

# Wajib. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# Wajib. Password halaman admin, minimal 8 karakter, pakai yang panjang.
ADMIN_PASSWORD=

# Di server asli (VPS + HTTPS), isi ini:
# PUBLIC_URL=https://panel.domainmu.my.id
# COOKIE_SECURE=1
# TRUST_PROXY=1

# Opsional
# PANEL_PORT=8080
# BASE_PORT=4000

# --- Khusus Railway (isi di menu Variables Railway, bukan di file) ---
# PANEL_HOST=0.0.0.0
# DATA_FILE=/data/data.json
# PUBLIC_URL=https://nama-app.up.railway.app
# COOKIE_SECURE=1
# TRUST_PROXY=1
# Backup otomatis data.json ke Discord (URL webhook dari channel privat milikmu)
# BACKUP_WEBHOOK_URL=https://discord.com/api/webhooks/...
# BACKUP_EVERY_HOURS=12   (opsional, default 12)

# --- Wallet / QRIS otomatis (opsional) ---
# Kosongkan WALLET_MONGO_URL kalau fitur deposit WL di toko pembeli tidak dipakai.
# WALLET_MONGO_URL=mongodb+srv://user:pass@cluster/wallet
# WALLET_DB_NAME=autostore_wallet

# --- Autoko / QRIS dinamis (opsional) ---
# Dipakai untuk DUA hal sekaligus:
#   1. Deposit WL end-user di toko pembeli (via bot Discord)
#   2. Pembayaran pembelian KEY di /beli.html (auto-penerbitan key)
# Kalau AUTOKO_MODE=live dan AUTOKO_API_KEY terisi, halaman /beli.html otomatis pakai QRIS dinamis.
# Kalau Autoko nonaktif / createQris gagal untuk satu order, order itu otomatis fallback ke
# QRIS statis /qris.png (konfirmasi manual lewat /admin.html). Tidak ada user yang stuck.
# AUTOKO_MODE=mock            # mock | live | (kosong = nonaktif)
# AUTOKO_API_KEY=             # rahasia: token dari gateway
# AUTOKO_API_URL=https://api.satrosdev.my.id
# AUTOKO_MAX_PER_HOUR=45      # rem lokal, batas gateway 50/jam per IP
